# Copy to .env and fill in. docker compose reads .env automatically; it is
# git-ignored and excluded from images (.dockerignore).

# Required: Grafana admin password
GRAFANA_ADMIN_PASSWORD=change-me

# Optional overrides
# GRAFANA_PORT=3000
# WAF_PORT=8080
# FEEDBACK_API_KEY=at-least-16-random-characters
# WAF_ALERT_WEBHOOK_URL=https://n8n.example.com/webhook/sqli-alert
# WAF_ALERT_WEBHOOK_TOKEN=
# WAF_BACKEND_URL=http://host.docker.internal:3000
# WAF_BACKEND_HOST=your-app.vercel.app   # for a remote HTTPS backend
